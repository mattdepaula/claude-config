{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"cleanupPeriodDays": 90,
	"env": {
		"DISABLE_BUG_COMMAND": "1",
		"DISABLE_ERROR_REPORTING": "1",
		"DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
		"CLAUDE_CODE_ENABLE_TELEMETRY": "1",
		"CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
		"OTEL_METRICS_EXPORTER": "otlp",
		"OTEL_LOGS_EXPORTER": "otlp",
		"OTEL_TRACES_EXPORTER": "otlp",
		"OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
		"OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
		"OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
		"OTEL_LOG_USER_PROMPTS": "1",
		"OTEL_LOG_TOOL_DETAILS": "1",
		"OTEL_METRIC_EXPORT_INTERVAL": "10000",
		"OTEL_LOGS_EXPORT_INTERVAL": "5000"
	},
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"Agent",
			"Bash",
			"Read",
			"Search",
			"WebSearch",
			"Bash(cat:*)",
			"Bash(chmod:*)",
			"Bash(cp:*)",
			"Bash(curl:*)",
			"Bash(echo:*)",
			"Bash(find:*)",
			"Bash(grep:*)",
			"Bash(head:*)",
			"Bash(jq:*)",
			"Bash(ln:*)",
			"Bash(ls:*)",
			"Bash(mise:*)",
			"Bash(mkdir:*)",
			"Bash(npm show *)",
			"Bash(npm:*)",
			"Bash(npx tsc --noEmit)",
			"Bash(npx:*)",
			"Bash(osascript:*)",
			"Bash(pnpm ls *)",
			"Bash(python3:*)",
			"Bash(rm:*)",
			"Bash(sqlite3:*)",
			"Bash(wrangler:*)",
			"Skill(agentic-patterns:author-agent)",
			"Skill(agentic-patterns:author-hook)",
			"Skill(agentic-patterns:author-plugin)",
			"Skill(agentic-patterns:author-script)",
			"Skill(agentic-patterns:author-skill)",
			"Skill(agentic-patterns:author-slash-command)",
			"Skill(agentic-patterns:delegate-to-agents)",
			"Skill(agentic-patterns:deterministic-work)",
			"Skill(daily-ops:git-workflow)",
			"Skill(daily-ops:release-workflow)",
			"Skill(interaction-standards:clarify-then-plan)",
			"Skill(interaction-standards:conversation-style)",
			"Skill(interaction-standards:explain-dont-edit)",
			"Skill(interaction-standards:interaction-guide)",
			"Skill(interaction-standards:stay-in-scope)",
			"Skill(code-review:*)",
			"Skill(hookify:hookify)",
			"Skill(humanizer)",
			"Skill(plugin-dev:*)",
			"WebFetch(domain:api.anthropic.com)",
			"WebFetch(domain:api.github.com)",
			"WebFetch(domain:central.sonatype.com)",
			"WebFetch(domain:docs.anthropic.com)",
			"WebFetch(domain:docs.github.com)",
			"WebFetch(domain:formulae.brew.sh)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:mise.jdx.dev)",
			"WebFetch(domain:mvnrepository.com)",
			"WebFetch(domain:patch-diff.githubusercontent.com)",
			"WebFetch(domain:platform.claude.com)",
			"WebFetch(domain:prettier.io)",
			"WebFetch(domain:pypi.org)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:registry.npmjs.org)",
			"WebFetch(domain:repo1.maven.org)",
			"WebFetch(domain:stackoverflow.com)",
			"WebFetch(domain:vite.dev)",
			"WebFetch(domain:web.archive.org)",
			"WebFetch(domain:www.anthropic.com)",
			"WebFetch(domain:www.apache.org)",
			"WebFetch(domain:www.npmjs.com)",
			"mcp__agent-browser__*",
			"mcp__chrome-devtools__*",
			"mcp__plugin_context7_context7__*",
			"mcp__plugin_playwright_playwright__*"
		],
		"deny": [
			"Bash(git add -A:*)",
			"Bash(git add --all:*)",
			"Bash(npm i --global:*)",
			"Bash(npm i -g:*)",
			"Bash(npm install --global:*)",
			"Bash(npm install -g:*)",
			"Bash(mkfs:*)",
			"Bash(dd:*)",
			"Read(~/.gnupg/**)",
			"Read(~/.aws/**)",
			"Read(~/.azure/**)",
			"Read(~/.config/gh/**)",
			"Read(~/.git-credentials)",
			"Read(~/.docker/config.json)",
			"Read(~/.kube/**)",
			"Read(~/.npmrc)",
			"Read(~/.npm/**)",
			"Read(~/.pypirc)",
			"Read(~/.gem/credentials)",
			"Read(~/Library/Keychains/**)"
		],
		"ask": [
			"Bash(gh api*repos*/pulls:*)",
			"Bash(git push -f:*)",
			"Bash(git push --force:*)",
			"Bash(op:*)",
			"Bash(open:*)",
			"Bash(sudo:*)",
			"Bash(trash -fr:*)",
			"Bash(trash -r:*)",
			"Bash(trash -rf:*)",
			"Edit(CLAUDE.md)",
			"Edit(~/.bashrc)",
			"Edit(~/.claude/settings.json)",
			"Edit(~/.zprofile)",
			"Edit(~/.zshrc)",
			"Read(~/.ssh/**)",
			"Write(CLAUDE.md)"
		]
	},
	"enableAllProjectMcpServers": false,
	"enabledMcpjsonServers": [],
	"hooks": {},
	"statusLine": {
		"type": "command",
		"command": "~/.claude/statusline-command.sh",
		"padding": 0
	},
	"alwaysThinkingEnabled": true,
	"autoUpdatesChannel": "latest",
	"tui": "fullscreen",
	"skipDangerousModePermissionPrompt": true,
	"theme": "dark-daltonized",
	"verbose": true,
	"preferredNotifChannel": "ghostty",
	"fileCheckpointingEnabled": false,
	"teammateMode": "in-process",
	"voiceEnabled": true
}
